{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asr-contract/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective",
    "variable_policy",
    "problem_ref",
    "reference_ref",
    "evaluation_ref",
    "budget",
    "execution_policy",
    "intervention_policy",
    "provenance",
    "runtime_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "asr-contract/1"
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "success_criteria",
        "scope"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "success_criteria": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "variable_policy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ASR variable policy (not an executable research contract)",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "asr-variable-policy/1"
        },
        "variables": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "default": {},
              "value": {},
              "mode": {
                "enum": [
                  "fixed",
                  "bounded",
                  "open"
                ]
              },
              "scope": {
                "enum": [
                  "project",
                  "run",
                  "trial",
                  "evaluation"
                ]
              },
              "modifiable_by": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "human",
                    "researcher"
                  ]
                }
              },
              "allowed": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "minimum": {
                        "type": "number"
                      },
                      "maximum": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "minimum",
                      "maximum"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "choices": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "choices"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "implementation": {
                "type": "object",
                "properties": {
                  "interface": {
                    "type": "string",
                    "minLength": 1
                  },
                  "execution_permission": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "interface",
                  "execution_permission"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "unit",
              "default",
              "mode",
              "scope",
              "modifiable_by"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "bounded"
                    }
                  }
                },
                "then": {
                  "required": [
                    "allowed"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "open"
                    }
                  }
                },
                "then": {
                  "required": [
                    "implementation"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "variables"
      ],
      "additionalProperties": false
    },
    "problem_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reference_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "budget": {
      "type": "object",
      "required": [
        "attempts",
        "execution_ms",
        "research_walltime_ms",
        "turns",
        "tool_executions"
      ],
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "execution_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "research_walltime_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "tool_executions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "researchers",
        "candidate_interface",
        "timeout_seconds",
        "output_bytes",
        "max_concurrency",
        "retry_limit"
      ],
      "properties": {
        "researchers": {
          "const": 1
        },
        "candidate_interface": {
          "const": "asr-candidate/1"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "output_bytes": {
          "const": 104857600
        },
        "max_concurrency": {
          "const": 1
        },
        "retry_limit": {
          "const": 0
        }
      }
    },
    "intervention_policy": {
      "const": {
        "guidance_boundary": "next_submission",
        "pause": "drain"
      }
    },
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "auth_mode",
        "billing_mode",
        "quota_state",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "auth_mode": {
          "enum": [
            "subscription_oauth",
            "subscription_cli",
            "api_key"
          ]
        },
        "billing_mode": {
          "enum": [
            "subscription",
            "paid_api"
          ]
        },
        "quota_state": {
          "enum": [
            "unknown",
            "available",
            "exhausted",
            "rate_limited"
          ]
        },
        "paid_api_authorized": {
          "type": "boolean"
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
