{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASR variable policy (not an executable research contract)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "asr-variable-policy/1"
    },
    "variables": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "default": {},
          "value": {},
          "mode": {
            "enum": [
              "fixed",
              "bounded",
              "open"
            ]
          },
          "scope": {
            "enum": [
              "project",
              "run",
              "trial",
              "evaluation"
            ]
          },
          "modifiable_by": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "human",
                "researcher"
              ]
            }
          },
          "allowed": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  }
                },
                "required": [
                  "minimum",
                  "maximum"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "choices": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "choices"
                ],
                "additionalProperties": false
              }
            ]
          },
          "implementation": {
            "type": "object",
            "properties": {
              "interface": {
                "type": "string",
                "minLength": 1
              },
              "execution_permission": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "interface",
              "execution_permission"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "unit",
          "default",
          "mode",
          "scope",
          "modifiable_by"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "bounded"
                }
              }
            },
            "then": {
              "required": [
                "allowed"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "open"
                }
              }
            },
            "then": {
              "required": [
                "implementation"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "variables"
  ],
  "additionalProperties": false
}
